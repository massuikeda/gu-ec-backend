# .env としてコピーして使う環境変数の例
# （cp .env.example .env）。.env は .gitignore 済み（コードにコミットしないこと）。
# app/__init__.py が起動時に自動で読み込む（python-dotenv）。

# ローカルでSwagger UI（/docs）を使う場合のみ true にする。本番は未設定＝false のままにする。
ENABLE_API_DOCS=false

# CORSを有効にしたいOriginをカンマ区切りで指定（通常は未設定でよい。
# Next.jsのRoute Handler経由＝同一オリジンなのでCORS自体不要のため）。
ALLOWED_ORIGINS=

# 1SKUあたりの運用上限数量。Frontend側 OPERATIONAL_MAX_QUANTITY と合わせること。
OPERATIONAL_MAX_QUANTITY=99

# --- DB切り替え -------------------------------------------------------
# sqlite : ローカルのSQLiteファイル（既定のおすすめ。Azure不要・再起動してもデータが残る）
#          起動時にテーブル作成とダミー商品データ投入が自動で行われる。
# mysql  : Azure Database for MySQL（以下のDB_*が必須）
# memory : インメモリ（再起動で消える。主に自動テスト用）
# ※ Azureに切り替えるときは、ここを mysql にして下のDB_*を埋めるだけでよい。
DB_BACKEND=sqlite

# SQLiteファイルの保存先（DB_BACKEND=sqlite のとき使用）。
# 相対パスは gu-ec-backend/ フォルダ基準。
SQLITE_PATH=guec_local.db

# --- Azure Database for MySQL 接続情報（DB_BACKEND=mysql のとき使用） -----
# 値はAzureポータルの自分のDBリソース「接続」画面に表示されるもの。
# 例（クラス1のiwamuraさんの場合）:
#   DB_HOST=tech0-search-db-class12.mysql.database.azure.com
#   DB_USER=admin_class12
#   DB_NAME=guec_iwamura
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
